// The hub database: no client SDK reads or writes, ever. The hub's server identity reaches it through IAM, and every
// request it serves is checked against the caller's own OAuth token, scoped to that caller's users/{uid} subtree.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
